# 可用 sh deploy/configure-mvp.sh 生成随机凭据。不要复制开发默认密码。
COMPOSE_PROJECT_NAME=lexflow-mvp
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
COOKIE_SECURE=false
MYSQL_DATABASE=lexflow
MYSQL_USER=lexflow
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 为避免连接 URL 转义歧义，工作流和 RabbitMQ 密码使用16–128位字母、数字、_或-。
AI_WORKFLOW_MYSQL_PASSWORD=
RABBITMQ_DEFAULT_USER=lexflow
RABBITMQ_DEFAULT_PASS=
MINIO_ROOT_USER=lexflow
MINIO_ROOT_PASSWORD=
LEXFLOW_STORAGE_BUCKET=lexflow-files
LEXFLOW_INTERNAL_SECRET=
LEXFLOW_AI_MASTER_KEY=
LEXFLOW_AI_ALLOWED_HOSTS=api.deepseek.com
EXPORT_RETENTION_DAYS=0
CLEANUP_COMPACT_AFTER_DAYS=0
