  "visual": "slide",
  "code": [
    "export LEXFLOW_TENANT_NAME='演示律所'",
    "export LEXFLOW_ADMIN_USERNAME='admin'",
    "read -r -s LEXFLOW_ADMIN_PASSWORD",
    "export LEXFLOW_ADMIN_PASSWORD",
    "docker compose --env-file .env.mvp.local -f docker-compose.mvp.yml run --rm --no-deps -e LEXFLOW_TENANT_NAME -e LEXFLOW_ADMIN_USERNAME -e LEXFLOW_ADMIN_PASSWORD api --spring.profiles.active=bootstrap"
  ],
