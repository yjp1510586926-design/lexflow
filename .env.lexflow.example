# 复制为 .env；仅用于本机开发，提交前勿写入真实凭据。
COMPOSE_PROJECT_NAME=lexflow-dev
MYSQL_PORT=13306
MYSQL_DATABASE=lexflow
MYSQL_USER=lexflow
MYSQL_PASSWORD=lexflow_dev_only
MYSQL_ROOT_PASSWORD=lexflow_root_dev_only
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_DEFAULT_USER=lexflow
RABBITMQ_DEFAULT_PASS=lexflow_mq_dev_only
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ROOT_USER=lexflow
MINIO_ROOT_PASSWORD=lexflow_minio_dev_only
MILVUS_PORT=19530
MILVUS_HEALTH_PORT=19091

# Java AI 凭据加密主密钥：Base64 编码的 32 字节随机值；不提供共享默认值。
# 这不是模型 API Key。须注入 Java 进程环境；本文件不会自动注入本机 Java。
LEXFLOW_AI_MASTER_KEY=

# NestJS 模型出站域名白名单，逗号分隔；只填律所实际选用服务商的主机名。
# 留空时不会发起 Embedding 请求。配置文件本身不包含用户的模型 API Key。
LEXFLOW_AI_ALLOWED_HOSTS=

# AI 工作流持久化：同一 MySQL 实例中的独立数据库与账号，仅本机开发默认值。
# 在项目根运行 sh infra/mysql/init-ai-workflow.sh，再给 NestJS/初始化命令注入此 URL。
# 该账号不能读取 Java 业务库。修改已有账号密码需显式处理，不由初始化脚本覆盖。
AI_WORKFLOW_MYSQL_PASSWORD=lexflow_ai_dev_only
AI_WORKFLOW_DATABASE_URL=mysql://lexflow_ai:lexflow_ai_dev_only@127.0.0.1:13306/lexflow_ai

# NestJS 消费队列选择；未设置时连接全部四个，独立文书验收可仅选 document.generate。
AI_TASK_QUEUES=document.parse,contract.review,knowledge.ingest,document.generate

# Java 请求审计离线缓冲；父目录须已存在，缓冲目录只允许运行账号读写。
# 放到持久磁盘并保留 .key；不得与模型 Key 混用或删除尚未重放的记录。
# AUDIT_BUFFER_DIRECTORY=/absolute/existing-parent/lexflow-audit-buffer
AUDIT_BUFFER_MAX_RECORDS=10000
AUDIT_BUFFER_MAX_BYTES=20971520
AUDIT_REPLAY_BATCH_SIZE=100
AUDIT_REPLAY_DELAY_MS=15000

# 0 表示关闭自动到期/归档；上线前确认保留策略后再启用。
EXPORT_RETENTION_DAYS=0
CLEANUP_COMPACT_AFTER_DAYS=0
